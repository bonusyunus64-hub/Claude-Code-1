# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env.local
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# roster source data — raw ROSTR exports and collection dumps hold real manager
# names and email addresses. ROSTER_CONTEXT.md already told agents these were
# ignored; until now they weren't, so nothing stopped one being committed.
data/*.xlsx
rostr-raw-collection.json

# Saved Claude Code session transcripts. Kept locally for picking a session back
# up (see notes/*-handoff.md for the readable summary of each), but not committed:
# they're ~800KB of verbose JSONL apiece and quote roster contact data in tool
# output. The handoff markdown alongside them IS committed — that's the artifact
# worth having in history.
notes/*.jsonl
