# Copy this file to .env.local and fill in the values

# Password to access the site
SITE_PASSWORD=your-secure-password-here

# Key used to encrypt SMTP passwords for saved email accounts (lib/accounts.ts).
# Set this explicitly and keep it safe. If left unset, account encryption silently
# falls back to SITE_PASSWORD - which means changing your site password later makes
# every saved account undecryptable and they all have to be re-added. Any long
# random string works; generate one with `openssl rand -hex 32` and don't rotate it
# casually once accounts are saved.
ACCOUNTS_SECRET=your-random-encryption-key-here

# Zoho Mail SMTP credentials
ZOHO_USER=yourname@zohomail.com
ZOHO_PASS=your-zoho-password-or-app-password

# Optional: base URL (used for logout redirect)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Upstash Redis (Vercel Storage tab -> Create Database -> Upstash Redis).
# Powers cross-device sync of templates/accounts/settings — without these,
# the app still works but falls back to browser-only localStorage.
# Vercel names these KV_REST_API_URL / KV_REST_API_TOKEN when you connect the
# database from the dashboard; copy those exact values here for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Spotify Web API (Client Credentials flow) — lets the Spotify badge in the
# Recipients Preview link straight to the artist's real Spotify page instead
# of a search results page. Create a free app at
# https://developer.spotify.com/dashboard, then copy its Client ID/Secret here.
# Without these, the Spotify link falls back to a search page.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Authenticates Vercel Cron's daily calls to /api/cron/refresh-replies (refreshes
# campaign reply/bounce data over IMAP so the dashboard's follow-up reminders stay
# accurate — it never sends anything) and /api/cron/drain-send-window. Vercel
# automatically sends this as an `Authorization: Bearer <value>` header when it
# invokes a scheduled cron job - generate any random string with
# `openssl rand -hex 32` and set the same value here and in the Vercel project's
# environment variables. Without it both cron routes always return 401.
CRON_SECRET=your-random-cron-secret-here
