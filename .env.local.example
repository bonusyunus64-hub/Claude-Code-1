# Copy this file to .env.local and fill in the values

# Password to access the site
SITE_PASSWORD=your-secure-password-here

# Zoho Mail SMTP credentials
ZOHO_USER=yourname@zohomail.com
ZOHO_PASS=your-zoho-password-or-app-password

# Optional: base URL (used for logout redirect)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Upstash Redis (Vercel Storage tab -> Create Database -> Upstash Redis).
# Powers cross-device sync of templates/accounts/settings — without these,
# the app still works but falls back to browser-only localStorage.
# Vercel names these KV_REST_API_URL / KV_REST_API_TOKEN when you connect the
# database from the dashboard; copy those exact values here for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
