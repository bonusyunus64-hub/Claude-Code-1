# Copy this file to .env.local and fill in the values

# Password to access the site
SITE_PASSWORD=your-secure-password-here

# Zoho Mail SMTP credentials
ZOHO_USER=yourname@zohomail.com
ZOHO_PASS=your-zoho-password-or-app-password

# Optional: base URL (used for logout redirect)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
